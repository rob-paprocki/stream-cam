{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Destination profile",
  "description": "One stream destination, as the app exports and imports it. Secrets (passphrases, passwords and stream keys) are never part of a profile file; the app asks for them after an import. Uses only core keywords so that simple validators on every platform agree.",
  "$comment": "Every pattern ends with (?![\\s\\S]), the very end of the text, instead of $. In Python, Java and ICU, $ also matches just before a line break at the end, so a name such as \"Studio\\n\" would pass.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "The profile file format. Version 1 is the only one so far.",
      "type": "integer",
      "const": 1
    },
    "id": {
      "description": "A stable ID for the profile.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}(?![\\s\\S])"
    },
    "name": {
      "description": "The name shown in the app: 1 to 80 characters, no line breaks, not starting with a space.",
      "type": "string",
      "pattern": "^[^ \\u0000-\\u001F\\u007F][^\\u0000-\\u001F\\u007F]{0,79}(?![\\s\\S])"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "allowFallback": {
      "description": "Whether the stream may use another network when the chosen one is missing.",
      "type": "boolean",
      "default": false
    },
    "destination": {
      "$ref": "#/$defs/destination"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "destination"
  ],
  "additionalProperties": false,
  "$defs": {
    "network": {
      "description": "The network the stream must use. auto follows the system's default network.",
      "type": "string",
      "enum": [
        "auto",
        "wifi",
        "cellular",
        "ethernet"
      ],
      "default": "auto"
    },
    "encryption": {
      "description": "SRT encryption. Anything but none needs a passphrase, which the app asks for.",
      "type": "string",
      "enum": [
        "none",
        "aes128",
        "aes192",
        "aes256"
      ],
      "default": "none"
    },
    "host": {
      "description": "A host name of at most 253 characters, an IPv4 address, or an IPv6 address without square brackets.",
      "type": "string",
      "pattern": "^(?![A-Za-z0-9.-]{254})(?:(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))(?![\\s\\S])"
    },
    "remotePort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "latencyMs": {
      "description": "SRT latency in milliseconds.",
      "type": "integer",
      "minimum": 20,
      "maximum": 8000,
      "default": 120
    },
    "username": {
      "description": "A user name for RTSP sign-in: printable ASCII without spaces or colons.",
      "type": "string",
      "pattern": "^[!-9;-~]{1,64}(?![\\s\\S])"
    },
    "namePart": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,63}(?![\\s\\S])"
    },
    "destination": {
      "description": "Where the stream goes. The type field picks one of the forms below.",
      "oneOf": [
        {
          "$ref": "#/$defs/srtCaller"
        },
        {
          "$ref": "#/$defs/srtListener"
        },
        {
          "$ref": "#/$defs/rtmpPush"
        },
        {
          "$ref": "#/$defs/rtspPush"
        },
        {
          "$ref": "#/$defs/rtspPull"
        },
        {
          "$ref": "#/$defs/rtmpPull"
        }
      ]
    },
    "srtCaller": {
      "type": "object",
      "description": "The app connects out to an SRT listener.",
      "properties": {
        "type": {
          "const": "srtCaller"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "port": {
          "$ref": "#/$defs/remotePort"
        },
        "streamId": {
          "description": "The SRT stream ID, if the server needs one.",
          "type": "string",
          "pattern": "^[!-~]{1,512}(?![\\s\\S])"
        },
        "latencyMs": {
          "$ref": "#/$defs/latencyMs"
        },
        "encryption": {
          "$ref": "#/$defs/encryption"
        }
      },
      "required": [
        "type",
        "host",
        "port"
      ],
      "additionalProperties": false
    },
    "srtListener": {
      "type": "object",
      "description": "The app waits for an SRT caller to connect in.",
      "properties": {
        "type": {
          "const": "srtListener"
        },
        "port": {
          "type": "integer",
          "minimum": 1025,
          "maximum": 65535,
          "default": 9000
        },
        "latencyMs": {
          "$ref": "#/$defs/latencyMs"
        },
        "encryption": {
          "$ref": "#/$defs/encryption"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "rtmpPush": {
      "type": "object",
      "description": "The app publishes to an RTMP server. The stream key is a secret, so it isn't here.",
      "properties": {
        "type": {
          "const": "rtmpPush"
        },
        "url": {
          "description": "rtmp:// or rtmps://, a host, an optional port and the app path; no query.",
          "type": "string",
          "pattern": "^rtmps?://(?![A-Za-z0-9.-]{254})(?:(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))\\])(?::(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?(?:/[A-Za-z0-9._~-]+)+(?![\\s\\S])"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false
    },
    "rtspPush": {
      "type": "object",
      "description": "The app publishes to an RTSP server. The password is a secret, so it isn't here.",
      "properties": {
        "type": {
          "const": "rtspPush"
        },
        "url": {
          "description": "rtsp:// or rtsps://, a host, an optional port and the stream path; no query.",
          "type": "string",
          "pattern": "^rtsps?://(?![A-Za-z0-9.-]{254})(?:(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?|(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?::[0-9A-Fa-f]{1,4}){1,6}|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))\\])(?::(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?(?:/[A-Za-z0-9._~-]+)+(?![\\s\\S])"
        },
        "username": {
          "$ref": "#/$defs/username"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false
    },
    "rtspPull": {
      "type": "object",
      "description": "The app runs an RTSP server at rtsp://<device>:<port>/<path>.",
      "properties": {
        "type": {
          "const": "rtspPull"
        },
        "port": {
          "type": "integer",
          "minimum": 1025,
          "maximum": 65535,
          "default": 8554
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,63}(?:/[A-Za-z0-9][A-Za-z0-9._~-]{0,63}){0,7}(?![\\s\\S])"
        },
        "username": {
          "$ref": "#/$defs/username"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "additionalProperties": false
    },
    "rtmpPull": {
      "type": "object",
      "description": "The app runs an RTMP server at rtmp://<device>:<port>/<app>/<streamName>.",
      "properties": {
        "type": {
          "const": "rtmpPull"
        },
        "port": {
          "type": "integer",
          "minimum": 1025,
          "maximum": 65535,
          "default": 1935
        },
        "app": {
          "$ref": "#/$defs/namePart"
        },
        "streamName": {
          "$ref": "#/$defs/namePart"
        }
      },
      "required": [
        "type",
        "app",
        "streamName"
      ],
      "additionalProperties": false
    }
  }
}
