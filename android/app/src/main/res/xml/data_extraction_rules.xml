<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing the app keeps is backed up or moved to a new phone, the same as android:allowBackup="false" on
    older Android versions. Recordings live in the shared Movies folder, which isn't part of app data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
